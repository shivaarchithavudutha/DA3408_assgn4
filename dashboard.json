{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "title": "System Health & Core Services Overview",
      "type": "row"
    },
    {
      "id": 1,
      "title": "Service Health Status",
      "description": "Monitors the real-time operational status (1=Up, 0=Down) of the Streamlit AI captioning server and node_exporter daemon.",
      "type": "stat",
      "gridPos": { "h": 5, "w": 8, "x": 0, "y": 1 },
      "targets": [
        {
          "expr": "up{job=~\"streamlit_ai_app|node_exporter\"}",
          "legendFormat": "{{job}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "ONLINE", "color": "green" } } }
          ],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] }
        }
      }
    },
    {
      "id": 2,
      "title": "Concurrent Active CPU Tasks",
      "description": "Gauge tracking current active inference routines running on the CPU core for single vs bulk modes.",
      "type": "stat",
      "gridPos": { "h": 5, "w": 8, "x": 8, "y": 1 },
      "targets": [
        {
          "expr": "sum by (mode) (caption_requests_in_progress)",
          "legendFormat": "Mode: {{mode}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": { "mode": "absolute", "steps": [{ "color": "blue", "value": null }, { "color": "orange", "value": 2 }] }
        }
      }
    },
    {
      "id": 3,
      "title": "Total Processed Items",
      "description": "Cumulative count of successfully captioned images partitioned by ingestion mode.",
      "type": "stat",
      "gridPos": { "h": 5, "w": 8, "x": 16, "y": 1 },
      "targets": [
        {
          "expr": "sum by (mode) (caption_images_processed_total{status=\"success\"})",
          "legendFormat": "{{mode}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "palette-classic" }
        }
      }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 6 },
      "id": 101,
      "title": "Application Throughput & Latency Distributions",
      "type": "row"
    },
    {
      "id": 4,
      "title": "Inference Throughput | Images per Second",
      "description": "Calculates per-second completion rate of image captions across Single and Bulk pipelines.",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 7 },
      "targets": [
        {
          "expr": "sum by (mode) (rate(caption_images_processed_total{status=\"success\"}[30s]))",
          "legendFormat": "Throughput ({{mode}})",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "showPoints": "auto" },
          "color": { "mode": "palette-classic" }
        }
      }
    },
    {
      "id": 5,
      "title": "Inference Duration Distribution | P95 vs Mean",
      "description": "Histograms tracking P95 percentile and mathematical average elapsed time per image inference.",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 7 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(caption_inference_duration_seconds_bucket[1m])))",
          "legendFormat": "P95 Latency (s)",
          "refId": "A"
        },
        {
          "expr": "rate(caption_inference_duration_seconds_sum[1m]) / rate(caption_inference_duration_seconds_count[1m])",
          "legendFormat": "Mean Latency (s)",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "drawStyle": "line", "showPoints": "always" },
          "color": { "mode": "palette-classic" }
        }
      }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 15 },
      "id": 102,
      "title": "Hardware & Infrastructure Resource Corroboration",
      "type": "row"
    },
    {
      "id": 6,
      "title": "Host CPU Utilization Correlated with Inference",
      "description": "Tracks percentage load across VM CPU cores to observe computational saturation during bulk zip extraction and model forward passes.",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "targets": [
        {
          "expr": "100 - (avg by (instance) (rate(node_cpu_seconds_total{mode=\"idle\"}[30s])) * 100)",
          "legendFormat": "Total Host CPU (%)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "custom": { "drawStyle": "line", "fillOpacity": 20 },
          "color": { "mode": "fixed", "fixedColor": "orange" }
        }
      }
    },
    {
      "id": 7,
      "title": "Memory Footprint | Application RSS vs Available RAM",
      "description": "Compares resident set size memory allocated by the Python AI worker against total remaining host memory.",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "targets": [
        {
          "expr": "caption_app_memory_usage_bytes",
          "legendFormat": "Streamlit App RSS",
          "refId": "A"
        },
        {
          "expr": "node_memory_MemAvailable_bytes",
          "legendFormat": "Available System RAM",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": { "drawStyle": "line" },
          "color": { "mode": "palette-classic" }
        }
      }
    }
  ],
  "refresh": "5s",
  "schemaVersion": 39,
  "style": "dark",
  "tags": ["da3408", "observability", "prometheus"],
  "time": { "from": "now-15m", "to": "now" },
  "timepicker": { "refresh_intervals": ["5s", "10s", "30s"] },
  "timezone": "browser",
  "title": "DA3408 A4: Production AI Observability Dashboard",
  "version": 1
}
